				{
					"name": "2.5 Create transaction (pay by invoice)",
					"request": {
						"description": "Creates the payment for pay by invoice with \"paymentType\": \"BILL_PAYMENT\". See docs/CreatePayment.md. Next, open the redirectUrl from the response in a browser, and complete the easyCredit sandbox checkout.",
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Session-Id",
								"value": "{{ctp_session_id}}",
